# Copie para .env e preencha. O .env NUNCA vai para o Git.

# ---- Modelo de linguagem (condicoes A, B, C, D) ----
ANTHROPIC_API_KEY=
MODELO_ID=claude-haiku-4-5-20251001
TEMPERATURA=0
MAX_TOKENS_SAIDA=400

# ---- Guarda de orcamento (restricao inviolavel 9) ----
# MODO_SIMULADO=1 nao emite nenhuma requisicao real.
MODO_SIMULADO=1
# O teto em dolares e o limite que de fato importa. O teto de chamadas existe como
# guarda contra laco infinito e por isso e folgado: precisa comportar duas execucoes
# completas do protocolo (2 x 3.883 = 7.766) mais piloto e testes de fumaca.
TETO_CHAMADAS=8500
TETO_USD=16.00
# Estimativa conservadora usada para reservar o custo ANTES de cada chamada.
# Acima do custo unitario medido (US$ 0,001646) de proposito.
CUSTO_ESTIMADO_CHAMADA_USD=0.0025
PRECO_ENTRADA_USD_MTOK=1.0
PRECO_SAIDA_USD_MTOK=5.0
ARQUIVO_CONSUMO=resultados/consumo.json

# ---- Reprodutibilidade (restricao inviolavel 10) ----
SEMENTE_MESTRA=20260829

# ---- Condicao D: moderacao de conteudo ----
# `omni-moderation-latest` e referencia mutavel. O executor grava, em cada registro
# bruto, o identificador de modelo devolvido pela propria resposta da API, e esse
# valor e transcrito para docs/versoes.md apos a execucao.
OPENAI_API_KEY=
MODELO_MODERACAO=omni-moderation-latest

# ---- Servicos locais ----
CAMADA_PORTA=8000
RECUPERADOR_PORTA=8100
MODELO_PORTA=8200
# Versao do indice: muda a cada reindexacao do corpus. Viaja em toda resposta do
# recuperador e em todo registro bruto, permitindo reconstruir qual corpus e qual
# modelo de embeddings geraram cada contexto.
VERSAO_INDICE=0.0.0-stub
QDRANT_URL=http://qdrant:6333
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# ---- Camada ----
NIVEL_LOG=INFO
ARQUIVO_LOG=resultados/camada.jsonl
VERSAO_REGRAS=0.0.0-encaminhamento
