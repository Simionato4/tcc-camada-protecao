# Copie para .env e preencha. O .env NUNCA vai para o Git.

# ---- Modelo de linguagem (condicoes A, B, C, D) ----
ANTHROPIC_API_KEY=
MODELO_ID=claude-haiku-4-5-20251001
TEMPERATURA=0
MAX_TOKENS_SAIDA=400

# ---- Guarda de orcamento (restricao inviolavel 9) ----
# MODO_SIMULADO=1 nao emite nenhuma requisicao real.
MODO_SIMULADO=1
TETO_CHAMADAS=4500
TETO_USD=16.00
PRECO_ENTRADA_USD_MTOK=1.0
PRECO_SAIDA_USD_MTOK=5.0
ARQUIVO_CONSUMO=resultados/consumo.json

# ---- Reprodutibilidade (restricao inviolavel 10) ----
SEMENTE_MESTRA=20260829

# ---- Condicao D: moderacao de conteudo ----
OPENAI_API_KEY=
MODELO_MODERACAO=omni-moderation-latest

# ---- Servicos locais ----
CAMADA_PORTA=8000
QDRANT_URL=http://qdrant:6333
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# ---- Camada ----
NIVEL_LOG=INFO
ARQUIVO_LOG=resultados/camada.jsonl
VERSAO_REGRAS=0.0.0-encaminhamento
