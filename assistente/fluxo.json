      "parameters": {
        "jsCode": "// Concatena os documentos recuperados num unico texto, que e o que\n// sera submetido ao ponto de interceptacao de contexto.\nconst d = $input.first().json;\nconst contexto = d.documentos\n  .map((doc, i) => `[documento ${i + 1} | pedido ${doc.numero_pedido}]\\n${doc.texto}`)\n  .join('\\n\\n');\nreturn [{ json: { contexto, ids_recuperados: d.ids_recuperados,\n                  versao_indice: d.versao_indice } }];"
      },
